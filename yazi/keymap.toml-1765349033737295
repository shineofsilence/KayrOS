# ==================== ГЛАВНЫЙ РЕЖИМ ====================
[manager]

prepend_keymap = [
    # --------------------- Навигация ---------------------
    # J / K - прыжок на 3 строки (как у тебя map J 3j)
    { on = [ "J" ], run = "arrow 3" },
    { on = [ "K" ], run = "arrow -3" },

    # U / I - В начало и конец (твои map U bottom / I top)
    { on = [ "U" ], run = "arrow 99999999" }, # В самый низ
    { on = [ "I" ], run = "arrow -99999999" }, # В самый верх
    
    # l - ТОЛЬКО вход в папку. Если это файл - ничего не делает.
    # При входе курсор прыгает наверх (arrow -99999999).
    { on = [ "l" ], run = [ "enter", "arrow -99999999" ] },
    
    # Enter - открытие файла (как map <enter> open)
    { on = [ "<Enter>" ], run = "open" },
    
    # Возврат назад (h)
    { on = [ "h" ], run = "leave" },

    # --------------------- Операции с файлами ---------------------
    # x / X - Права доступа (через shell, чтобы не блокировать интерфейс)
    # block = false значит "не выходить в терминал"
    { on = [ "x" ], run = 'shell --confirm "chmod -x \"$@\""' },
    { on = [ "X" ], run = 'shell --confirm "chmod +x \"$@\""' },

    # g - Создать файл (с правами 644)
    # Используем input для ввода имени
    { on = [ "g" ], run = 'shell --block --confirm "read -p \"File name: \" name; touch \"$name\"; chmod 644 \"$name\""' },

    # G - Создать папку (с правами 755)
    { on = [ "G" ], run = 'shell --block --confirm "read -p \"Dir name: \" name; mkdir -p -m 755 \"$name\""' },
    
    # L - Симлинк (relative)
    { on = [ "L" ], run = "link --relative" },

    # t - Переименование
    { on = [ "t" ], run = "rename --cursor=before_ext" },

    # --------------------- Копирование / Вставка ---------------------
    { on = [ "c" ], run = "yank" },       # Copy
    { on = [ "C" ], run = "yank --cut" }, # Cut
    { on = [ "v" ], run = "paste" },      # Paste
    { on = [ "f" ], run = "toggle" },     # Выделение
    { on = [ "F" ], run = "escape" },     # Снять все выделения

    # --------------------- Удаление ---------------------
    # d - Удаление в корзину (безопасное)
    { on = [ "d" ], run = "remove" },
    
    # D - Удаление навсегда (rm -rf) через shell
    { on = [ "D" ], run = 'shell --block --confirm "rm -rf \"$@\""' },

    # --------------------- Разное ---------------------
    # . - Скрытые файлы + прыжок наверх
    { on = [ "." ], run = [ "hidden toggle", "arrow -99999999" ] },
    
    # , - Подсчет размера (Yazi делает это на лету, но можно вызвать пересчет)
    # На самом деле Yazi считает сам, просто нажми 'Z' (по дефолту) или оставим ','
    { on = [ "," ], run = "linemode size" },
    
    # S - аналог твоего подсчета размера папки (du)
    # В Yazi это встроено: нажми пробел, и он покажет размер
    
    # q - Выход
    { on = [ "q" ], run = "quit" },
]
