# =================== НАСТРОЙКИ ИНТЕРФЕЙСА ====================
set previewer ctpv       # Генератор превью
set cleaner ctpvclear    # Очистка превью
set sixel true           # Графический протокол (Sixel)
set dircounts true       # Счетчик файлов в папках
set icons true           # Отображение иконок
set errorfmt "\033[31;1m%s\033[0m"    # Читаемое отображение ошибок

# ===================== ОТКРЫТИЕ ФАЙЛОВ =======================
cmd open-text $nvim "$f"
cmd open-image ${{ imv "$f" & }}
cmd open-pdf   ${{ zathura "$f" & }}
cmd open-media ${{ mpv --force-window "$f" & }}

cmd open %{{
    mime=$(file --mime-type -b "$f")
    case "$mime" in
        image/*) lf -remote "send $id open-image" ;;
        video/*|audio/*) lf -remote "send $id open-media" ;;
        application/pdf) lf -remote "send $id open-pdf" ;;
        text/*|application/json|application/x-shellscript|application/xml) lf -remote "send $id open-text" ;;
        *) lf -remote "send $id open-text" ;;
    esac
}}

# ===================== ГОРЯЧИЕ КЛАВИШИ =======================
# . = Переключить скрытые файлы (вкл/выкл)
map . set hidden!

# Открыть файл
map <enter> open

# Создаем команду-фильтр: входить только в папки
cmd enter-dir %{{
    if [ -d "$f" ]; then
        lf -remote "send $id open"
    fi
}}
map l enter-dir
  
# Создание файла (права 644)
cmd touch %{{
    touch "$@"
    chmod 644 "$@"
}}
map n push :touch<space>

# Создание папки (права 755)
cmd mkdir %{{
    mkdir -p -m 755 "$@"
}}
map N push :mkdir<space>

# Создание ссылок
cmd ln %{{
    ln "$@"
}}
map L push :ln -s --relative<space>

# Сделать исполняемым (+x)
cmd chmod-exec %{{
    chmod +x "$f"
    lf -remote "send $id reload"
}}
map x chmod-exec

# Переименовать
map r rename

# Удалить (с подтверждением)
map D push :delete<enter>         

# Мгновенное удаление (ОПАСНО!) + Обновить список
cmd delete-now %{{
    rm -rf "$fx"
    lf -remote "send $id reload"
}}
map <delete> delete-now           # Удалить (клавиша Del)

# Выйти из файлового менеджера
map q quit

