# =================== НАСТРОЙКИ ИНТЕРФЕЙСА ====================
set previewer ctpv                    # Генератор превью
set cleaner ctpvclear                 # Очистка превью
set sixel true                        # Графический протокол (Sixel)
set dircounts true                    # Счетчик файлов в папках
set icons true                        # Отображение иконок
set errorfmt "\033[31;1m%s\033[0m"    # Читаемое отображение ошибок

# ===================== ОТКРЫТИЕ ФАЙЛОВ =======================
cmd open-text $nvim "$f"
cmd open-image ${{ imv "$f" & }}
cmd open-pdf   ${{ zathura "$f" & }}
cmd open-media ${{ mpv --force-window "$f" & }}

cmd open %{{
    mime=$(file --mime-type -b "$f")
    case "$mime" in
        image/*) lf -remote "send $id open-image" ;;
        video/*|audio/*) lf -remote "send $id open-media" ;;
        application/pdf) lf -remote "send $id open-pdf" ;;
        text/*|application/json|application/x-shellscript|application/xml) lf -remote "send $id open-text" ;;
        *) lf -remote "send $id open-text" ;;
    esac
}}

# ===================== ГОРЯЧИЕ КЛАВИШИ =======================
# --------------------- Навигация ----------------------
# Вниз
map j down
map J 3j                                          # Смещение на 3 строки
map u half-down                                   # Полстраницы вниз
map U bottom                                      # Конец списка

# Вверх
map k up
map K 3k                                          # Смещение на 3 строки
map i half-up                                     # Полстраницы вверх
map I top                                         # Начало списка

# Не открывать файлы по l 
cmd enter-dir %{{
    if [ -d "$f" ]; then
        lf -remote "send $id open"
    fi
}}
map l enter-dir

# ---------------------- Операции ----------------------
cmd touch %{{
    touch "$@"
    chmod 644 "$@"
}}
map g push :touch<space>                          # Создать файл (права 644)

cmd mkdir %{{
    mkdir -p -m 755 "$@"
}}
map G push :mkdir<space>                          # Создать папку (права 755)

cmd ln %{{
    ln "$@"
}}
map L push :ln -s --relative<space>               # Создать символьные ссылки

cmd chmod-exec %{{
    chmod +x "$f"
    lf -remote "send $id reload"
}}
map x chmod-exec                                  # Сделать исполняемым

map <enter> open                                  # Открыть файл
map t rename                                      # Переименовать
map f toggle                                      # Выделить/Снять (текущий)
map F unselect                                    # Снять выделение со всего
map c copy                                        # Копировать
map C cut                                         # Вырезать
map v paste                                       # Вставить
map . set hidden!                                 # Переключить видимость скрытых файлов
map d push :delete<enter>                         # Удаление с подтверждением
cmd delete-now %{{
    rm -rf "$fx"
    lf -remote "send $id reload"
}}
map D delete-now                                  # Мгновенное удаление без подтверждения
map q quit                                        # Выйти из файлового менеджера

# ----------------------- Поиск ------------------------
set globsearch false                              # Отключаем glob (*), включаем Regex
# set incsearch true                                # Инкрементальный поиск (показывает сразу)
set ignorecase true                               # Игнорировать регистр
map m find-next                                   # Найти следующее совпадение
map M find-prev                                   # Найти предыдущее совпадение

