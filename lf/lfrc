# === НАСТРОЙКИ ===
set previewer ctpv       # Использовать ctpv для картинок и текста
set cleaner ctpvclear    # Чистить превью при выходе
set sixel true           # Включить графический протокол
set dircounts true       # Показывать кол-во файлов в папках
set icons true           # Если используешь nerd-fonts

# === ОТКРЫТИЕ ФАЙЛОВ ===
# === ОПРЕДЕЛЕНИЕ КОМАНД (ACTIONS) ===
# $nvim означает: "LF, отдай терминал неовиму"
cmd open-text $nvim "$f"

# {{ ... & }} означает: "Shell, запусти в фоне"
cmd open-image ${{ imv "$f" & }}
cmd open-pdf   ${{ zathura "$f" & }}
cmd open-media ${{ mpv --force-window "$f" & }}

# === ЛОГИКА ВЫБОРА (ROUTER) ===
# Мы используем lf -remote, чтобы вызвать команды выше из shell-скрипта
cmd open ${{
    # Определяем тип файла (нужен пакет 'file')
    mime=$(file --mime-type -b "$f")

    case "$mime" in
        image/*) 
            lf -remote "send $id open-image" ;;
        video/*|audio/*) 
            lf -remote "send $id open-media" ;;
        application/pdf) 
            lf -remote "send $id open-pdf" ;;
        text/*|application/json|application/x-shellscript|application/xml) 
            lf -remote "send $id open-text" ;;
        *) 
            # Fallback: если не поняли что это, пробуем открыть как текст
            lf -remote "send $id open-text" ;;
    esac
}}

map <enter> open

# === СОЗДАНИЕ (FILESYSTEM) ===
# n = Создать файл. Внизу появится ':touch ', пиши имя и Enter.
map n push :touch<space>
# N = Создать папку. Внизу появится ':mkdir -p ', пиши имя и Enter.
map N push :mkdir -p<space>
# L = Создать симлинк (относительный).
# Внизу появится ':ln -s --relative ', пиши цель и имя.
map L push :ln -s --relative<space>

# === УДАЛЕНИЕ (DELETE) ===
# D = Удалить выделенное.
# push вводит команду ':delete', но ждет от тебя Enter.
# LF спросит "delete X files? [y/n]", так что это БЕЗОПАСНО.
map D push :delete<enter>

# <Delete> (кнопка) = Удалить сразу без лишних вопросов (в корзину/trash, если настроить)
# Но пока оставим стандартный безопасный вариант:
map <delete> push :delete<enter>

# === ДРУГОЕ ===
# r = Переименовать (стандартно, но на всякий случай)
map r push :rename<space>
# q = Выход
map q quit
